#pragma once

// The numeric version format is AAAAABBBBBCCCCCDDDE where:
//
// AAAAA - major version number
// BBBBB - minor version number
// CCCCC - bugfix version number
// DDD   - alpha / beta (DDD + 500) version number
// E     - final (0) / snapshot (1)
//
// When DDDE is not 0, 1 is subtracted from AAAAABBBBBCCCCC. For example:
//
// Version      AAAAABBBBBCCCCCDDDE
//
// 0.1.0        0000000001000000000
// 0.1.2        0000000001000020000
// 1.2.3        0000100002000030000
// 2.2.0-a.1    0000200001999990010
// 3.0.0-b.2    0000299999999995020
// 2.2.0-a.1.z  0000200001999990011
//
#define LIBSTUD_REGEX_VERSION       $libstud_regex.version.project_number$ULL
#define LIBSTUD_REGEX_VERSION_STR   "$libstud_regex.version.project$"
#define LIBSTUD_REGEX_VERSION_ID    "$libstud_regex.version.project_id$"
#define LIBSTUD_REGEX_VERSION_FULL  "$libstud_regex.version$"

#define LIBSTUD_REGEX_VERSION_MAJOR $libstud_regex.version.major$
#define LIBSTUD_REGEX_VERSION_MINOR $libstud_regex.version.minor$
#define LIBSTUD_REGEX_VERSION_PATCH $libstud_regex.version.patch$

#define LIBSTUD_REGEX_PRE_RELEASE   $libstud_regex.version.pre_release$

#define LIBSTUD_REGEX_SNAPSHOT_SN   $libstud_regex.version.snapshot_sn$ULL
#define LIBSTUD_REGEX_SNAPSHOT_ID   "$libstud_regex.version.snapshot_id$"
